# --- Application Configuration ---
APP_NAME="Neural Zero-Trust AI Firewall & Red-Team Arena"
APP_VERSION="1.0.0"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
LOG_LEVEL="INFO"

# --- Database (Async SQLite locally; PostgreSQL compatible in production) ---
DATABASE_URL="sqlite+aiosqlite:///./zero_trust_arena.db"

# --- PyTorch Neural Guard & Entropy Thresholds ---
PYTORCH_EMBED_DIM=64
PYTORCH_ATTENTION_HEADS=4
NEURAL_THREAT_THRESHOLD=0.62
SHANNON_ENTROPY_THRESHOLD=4.35
ENABLE_AUTO_PII_REDACTION=True

# --- Pinecone Vector Threat Intelligence Configuration ---
PINECONE_API_KEY=""
PINECONE_INDEX_NAME="owasp-llm-threat-signatures"
PINECONE_SIMILARITY_THRESHOLD=0.72

# --- DSPy & CrewAI Self-Hardening Configuration ---
DSPY_BOOTSTRAP_ROUNDS=3